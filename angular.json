{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "packages",
  "projects": {
    "quartz-core": {
      "root": "packages/core",
      "sourceRoot": "packages/core/src",
      "projectType": "library",
      "prefix": "qz",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "packages/core/ng-package.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["packages/core/**/*.ts", "packages/core/**/*.html"]
          }
        }
      }
    },
    "quartz-primitives": {
      "root": "packages/primitives",
      "sourceRoot": "packages/primitives/src",
      "projectType": "library",
      "prefix": "qz",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "packages/primitives/ng-package.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["packages/primitives/**/*.ts", "packages/primitives/**/*.html"]
          }
        }
      }
    },
    "demo": {
      "root": ".",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "architect": {
        "test": {
          "builder": "@angular-devkit/build-angular:vitest",
          "options": {
            "configFile": "vitest.config.ts"
          }
        },
        "e2e": {
          "builder": "playwright-ng-schematics:e2e",
          "options": {
            "configFile": "playwright.config.ts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    }
  }
}
