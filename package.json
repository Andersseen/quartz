{
  "name": "quartz",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build:lib": "ng build quartz-core && cp README.md packages/core/dist/ && cp LICENSE packages/core/dist/ && ng build quartz-primitives && cp README.md packages/primitives/dist/ && cp LICENSE packages/primitives/dist/",
    "build:demo": "vite build && node scripts/prepare-search.mjs && doq-search index dist/analog/public",
    "docs:api": "node scripts/docs-api.mjs generate",
    "docs:api:check": "node scripts/docs-api.mjs check",
    "docs:content": "doq content generate",
    "docs:content:check": "doq content check",
    "docs:check": "node scripts/check-docs-output.mjs",
    "docs:doctor": "doq doctor --strict",
    "docs:preview": "node scripts/preview-static.mjs dist/analog/public",
    "verify:build": "node scripts/verify-build.js",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:inventory:check": "node scripts/api-inventory.mjs --check",
    "release:pack": "node scripts/release/release.mjs pack --out release-artifacts",
    "release:verify": "node scripts/release/release.mjs verify --dir release-artifacts",
    "release:plan": "node scripts/release/release.mjs plan --dir release-artifacts",
    "verify:consumer": "node scripts/consumer-smoke.js",
    "verify:consumer:runtime": "node scripts/consumer/run.mjs",
    "review:manual": "node scripts/consumer/run.mjs --fixture angular-21.2 --stage serve",
    "review:manual:check": "node scripts/consumer/manual-review.mjs --check",
    "verify:consumer:cli": "node scripts/consumer/cli.mjs",
    "verify:bundle": "node scripts/consumer/bundle-size.mjs --check",
    "verify:evidence": "node scripts/consumer/evidence-matrix.mjs",
    "pages:build": "pnpm build:demo",
    "pages:deploy": "pnpm pages:build && wrangler pages deploy dist/analog/public",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "ng build quartz-core && tsc --noEmit -p packages/core/tsconfig.lib.json && tsc --noEmit -p packages/primitives/tsconfig.lib.json && tsc --noEmit -p packages/primitives/forms/tsconfig.lib.json && tsc --noEmit -p tsconfig.app.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint \"{packages/core,packages/primitives,src}/**/*.{ts,html}\"",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "quartz": "node cli/bin/quartz.js",
    "prepare": "husky",
    "publish:lib": "echo 'Direct publishing is disabled. Publish only through the guarded GitHub workflow (see docs/releases/RELEASE_RUNBOOK.md).' && exit 1"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix"
    ],
    "*.{ts,html,scss,json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.1",
  "dependencies": {
    "@analogjs/content": "^2.9.2",
    "@analogjs/platform": "^2.9.2",
    "@analogjs/router": "^2.9.2",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@doqs/analog": "0.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@voltui/components": "^1.0.1",
    "angular-movement": "0.8.0",
    "front-matter": "^4.0.2",
    "lumen-icons": "^0.1.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.2",
    "@analogjs/vitest-angular": "^2.9.2",
    "@angular-devkit/build-angular": "^21.2.6",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/eslint-plugin": "21.3.1",
    "@angular-eslint/eslint-plugin-template": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular-eslint/template-parser": "21.3.1",
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@angular/platform-server": "^21.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.59.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/angular": "^19.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20.17.19",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "ng-packagr": "^21.2.2",
    "pagefind": "1.5.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
